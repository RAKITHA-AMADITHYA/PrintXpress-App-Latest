<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Hero: greeting + order status, flowing out of the action bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/hero_subtitle"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="16dp"
                android:text="What would you like to do?" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:columnCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProducts"
                    style="@style/TileCard">

                    <LinearLayout style="@style/TileContent">

                        <ImageView
                            style="@style/TileIcon"
                            android:backgroundTint="@color/tile_products"
                            android:contentDescription="Browse Products"
                            android:src="@drawable/ic_tile_products" />

                        <TextView
                            style="@style/TileTitle"
                            android:text="Browse Products" />

                        <TextView
                            style="@style/TileHint"
                            android:text="Catalogue &amp; pricing" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnOrders"
                    style="@style/TileCard">

                    <LinearLayout style="@style/TileContent">

                        <ImageView
                            style="@style/TileIcon"
                            android:backgroundTint="@color/tile_orders"
                            android:contentDescription="My Orders"
                            android:src="@drawable/ic_tile_orders" />

                        <TextView
                            style="@style/TileTitle"
                            android:text="My Orders" />

                        <TextView
                            style="@style/TileHint"
                            android:text="Track &amp; reorder" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnOffers"
                    style="@style/TileCard">

                    <LinearLayout style="@style/TileContent">

                        <ImageView
                            style="@style/TileIcon"
                            android:backgroundTint="@color/tile_offers"
                            android:contentDescription="Offers"
                            android:src="@drawable/ic_tile_offers" />

                        <TextView
                            style="@style/TileTitle"
                            android:text="Offers" />

                        <TextView
                            style="@style/TileHint"
                            android:text="Deals &amp; promo codes" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnGallery"
                    style="@style/TileCard">

                    <LinearLayout style="@style/TileContent">

                        <ImageView
                            style="@style/TileIcon"
                            android:backgroundTint="@color/tile_gallery"
                            android:contentDescription="Design Gallery"
                            android:src="@drawable/ic_tile_gallery" />

                        <TextView
                            style="@style/TileTitle"
                            android:text="Design Gallery" />

                        <TextView
                            style="@style/TileHint"
                            android:text="Get inspired" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnHelp"
                    style="@style/TileCard">

                    <LinearLayout style="@style/TileContent">

                        <ImageView
                            style="@style/TileIcon"
                            android:backgroundTint="@color/tile_help"
                            android:contentDescription="Guidelines and FAQ"
                            android:src="@drawable/ic_tile_help" />

                        <TextView
                            style="@style/TileTitle"
                            android:text="Guidelines &amp; FAQ" />

                        <TextView
                            style="@style/TileHint"
                            android:text="How printing works" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProfile"
                    style="@style/TileCard">

                    <LinearLayout style="@style/TileContent">

                        <ImageView
                            style="@style/TileIcon"
                            android:backgroundTint="@color/tile_profile"
                            android:contentDescription="My Profile"
                            android:src="@drawable/ic_tile_profile" />

                        <TextView
                            style="@style/TileTitle"
                            android:text="My Profile" />

                        <TextView
                            style="@style/TileHint"
                            android:text="Account &amp; addresses" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
